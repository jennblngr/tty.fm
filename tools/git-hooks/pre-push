#!/bin/sh
# Refuses to push to main or to a branch whose name does not follow
# doc/conventions.md. Skip with --no-verify.
check="$(git rev-parse --show-toplevel)/tools/conventions/check.sh"
[ -x "$check" ] || exit 0 # a branch from before the checks existed
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  case $remote_ref in refs/heads/*) ;; *) continue ;; esac
  case $local_sha in *[!0]*) ;; *) continue ;; esac # deleting a branch
  branch=${remote_ref#refs/heads/}
  if [ "$branch" = main ]; then
    echo "✗ do not push to main: open a pull request (doc/conventions.md)" >&2
    status=1
  elif ! "$check" branch "$branch"; then
    status=1
  fi
done
exit $status
