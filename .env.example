# Application name (image and container name). Working title, change freely.
APP_NAME=selfstream

# Host folders on the NAS (UGOS Pro shared folders live under /volume1/...).
MUSIC_DIR=/volume1/Music
DATA_DIR=/volume1/docker/selfstream

# User/group owning those folders on the NAS (run `id` over SSH).
PUID=1000
PGID=10

ADMIN_USER=admin
ADMIN_PASSWORD=change-me

PORT=4533
TZ=Europe/Paris
# WATCH=true
# SCAN_INTERVAL=1h
# TRANSCODE_CACHE_MB=2048
# LOG_LEVEL=info
