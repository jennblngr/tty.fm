# Image and container name.
APP_NAME=ttyfm

# Host folders on the NAS (UGOS Pro shared folders live under /volume1/...).
MUSIC_DIR=/volume1/music
DATA_DIR=/volume1/docker/ttyfm/data

# Container user. Root without capabilities by default (needed on UGOS Pro
# for live folder watching, see docker-compose.yml). Elsewhere: `id` over SSH.
# PUID=1000
# PGID=100

ADMIN_USER=admin
ADMIN_PASSWORD=change-me

PORT=4533
TZ=Europe/Paris
# WATCH=true
# SCAN_INTERVAL=1h
# TRANSCODE_CACHE_MB=2048
# LOG_LEVEL=info
